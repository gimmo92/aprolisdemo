# Server-side only. Never prefix this variable with VITE_.
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_MODEL=claude-sonnet-5

# Browser-safe Supabase values (Project Settings > API).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-side only. Never expose the service-role key with a VITE_ prefix.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me

# Optional indexing limits.
INDEX_MAX_AI_PAGES=80
INDEX_MAX_PDF_BYTES=262144000
INDEX_AI_BATCH_PAGES=6
INDEX_AI_CONCURRENCY=2
INDEX_STALE_JOB_SECONDS=360
